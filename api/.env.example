# Address the API listens on
BIND_ADDR=0.0.0.0:8080
# PostgreSQL connection string
DATABASE_URL=postgres://hypercs:hypercs@localhost:5432/hypercs
# tracing filter, e.g. info,hypercs_api=debug,hypercs_server=debug
RUST_LOG=info
# Run migrations automatically on startup (default on in dev)
RUN_MIGRATIONS_ON_START=true
# Set true in production (HTTPS); session cookies get the Secure flag
COOKIE_SECURE=false
# Comma-separated list of allowed cross-origin origins; empty = same-origin only
ALLOWED_ORIGINS=
# Serve Swagger UI at /api/v1/docs (default: on in debug builds, off in release)
API_DOCS_ENABLED=true
# Bootstraps the first admin account on first start if no admin exists yet
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
