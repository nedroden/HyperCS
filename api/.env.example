# Address the API listens on
BIND_ADDR=0.0.0.0:8080
# PostgreSQL connection string
DATABASE_URL=postgres://hypercs:hypercs@localhost:5432/hypercs
# tracing filter, e.g. info,hypercs_api=debug,hypercs_server=debug
RUST_LOG=info
# Log format: "text" (default) or "json" (one JSON object per line)
LOG_FORMAT=text
# Run migrations automatically on startup (default: on in debug builds, off in release)
RUN_MIGRATIONS_ON_START=true
# Set true in production (HTTPS): Secure session cookies + HSTS header
COOKIE_SECURE=false
# Comma-separated origins (scheme://host[:port], no path/trailing slash). Empty = same-origin only.
# Used for CORS and as extra trusted origins for the CSRF Origin check, e.g. the Vite dev
# server (its proxy rewrites Host): http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
# Serve Swagger UI at /api/v1/docs (default: on in debug builds, off in release)
API_DOCS_ENABLED=true
# Flood control (account-based): minimum seconds between posts, stricter limit for accounts
# younger than POST_NEW_ACCOUNT_AGE_MINS, and the window for the duplicate-post guard.
# Set the intervals to 0 to disable.
POST_MIN_INTERVAL_SECS=5
POST_NEW_ACCOUNT_INTERVAL_SECS=30
POST_NEW_ACCOUNT_AGE_MINS=10
POST_DUPLICATE_WINDOW_SECS=120
# Bootstraps the first admin account on first start if no admin exists yet (idempotent).
# The password must be 10-128 characters.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
