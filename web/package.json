{
    "name": "hypercs-web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "oxlint && steiger ./src",
        "typecheck": "tsc -b --noEmit",
        "test": "vitest run",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check:api": "cargo run --quiet --manifest-path ../api/Cargo.toml -p hypercs-server -- openapi > ../api/target/openapi.check.json && openapi-typescript ../api/target/openapi.check.json -o ../api/target/schema.check.ts && prettier --stdin-filepath src/shared/api/generated/schema.ts < ../api/target/schema.check.ts | diff -u src/shared/api/generated/schema.ts -",
        "generate:api": "cargo run --quiet --manifest-path ../api/Cargo.toml -p hypercs-server -- openapi > ../api/target/openapi.json && openapi-typescript ../api/target/openapi.json -o src/shared/api/generated/schema.ts"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.9.1",
        "@tanstack/react-query": "^5.104.0",
        "i18next": "^26.4.2",
        "openapi-fetch": "^0.17.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.89.0",
        "react-i18next": "^17.0.15",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.18.4",
        "rehype-sanitize": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@feature-sliced/steiger-plugin": "^0.8.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "jsdom": "^30.1.1",
        "openapi-typescript": "^7.13.0",
        "oxlint": "^1.81.0",
        "prettier": "^3.9.9",
        "steiger": "^0.7.0",
        "typescript": "~6.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.3"
    },
    "overrides": {
        "openapi-typescript": {
            "typescript": "$typescript"
        }
    }
}
